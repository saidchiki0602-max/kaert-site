---
import Page from '../layouts/Page.astro';
import Faq from '../components/Faq.astro';
import AppLd from '../components/AppLd.astro';
import Product from '../components/Product.astro';
import DemoForm from '../components/DemoForm.astro';
---
<Page title="MOEpilote — L'appli des maîtres d'œuvre" description="Compte rendu de chantier dicté en 5 minutes, assurances des entreprises contrôlées, client informé sans appeler. Démo sur votre dernier CR." path="/moepilote/">
<Product who="Maîtres d'œuvre · architectes" status="Pilotes en cours" color="var(--moe)"
  title="Dictez votre compte rendu. L'agent rédige. Tout le monde reçoit."
  sub="L'appli des maîtres d'œuvre : le CR de visite en 5 minutes, les entreprises relancées, les assurances contrôlées, et un client qui n'a plus besoin d'appeler."
  feats={[
    { t: 'Le CR de chantier dicté.', p: "En sortant de la visite, vous parlez comme sur le chantier. L'agent identifie les entreprises, classe réserves et actions, fixe les délais, et rédige deux versions : technique pour les entreprises, en clair pour votre client. Diffusé avec accusés de lecture et relance automatique." },
    { t: 'Les assurances vérifiées, lot par lot.', p: "Décennale, RC, URSSAF, Kbis : l'agent lit chaque attestation, croise les activités couvertes avec le lot du marché, relance avant expiration, et bloque le visa d'une situation tant que le dossier n'est pas à jour. La décennale qui ne couvre pas le chauffage alors que le lot comprend la PAC : il la voit." },
    { t: 'La mise au point et le chantier, verrouillés.', p: "La MAP avec le client (plans, devis, entreprises, cahier des choix, planning, budget) signée dans l'appli ; puis réserves, PV, situations visées sur l'avancement réel." },
  ]}
  oui={{ intro: "La relance de l'électricien, le point hebdo à vos cinq clients, le visa de la situation corrigée, la mise en demeure : préparés, en attente de votre OUI. Six actions par jour en moyenne, trente secondes chacune.", items: [
    { b: 'Diffuser le CR n°14 — maison Le Goff', s: '9 entreprises, 6 réserves, 2 versions rédigées.' },
    { b: 'Relancer SARL Élec35 — réserve R-12 en retard', s: 'Échéance dépassée de 3 jours. Message ferme prêt.' },
    { b: 'Viser la situation n°3 — Lot 4 Plomberie', s: 'Corrigée à 48 % d’avancement réel (demandé : 60 %).' },
    { b: 'Point hebdo aux clients', s: '5 messages en clair, photos de la semaine jointes.' },
  ] }}
  client={{ label: 'Pour votre client', text: "Il a sa propre appli : photos chaque jour, compte rendu en clair, décisions guidées avec prix et délai, factures d'entreprise vérifiées avant qu'il paie, garanties conservées dix ans. Aucune mauvaise nouvelle ne lui arrive par quelqu'un d'autre que vous." }}
  price={{ big: '79 €', small: 'HT / mois / maître d’œuvre', p: "Pilotes en cours en Bretagne. Prix bloqué à vie pour les 200 premiers cabinets.", items: ['CR dicté, diffusion, relances, accusés de lecture', 'Contrôle des assurances et des situations', 'MAP, réserves, PV, DOE', 'Portail client illimité inclus', 'Options à la carte'] }}
  cta={{ label: 'Demander une démo sur votre dernier compte rendu', href: '/moepilote/#demo' }}>
  <svg slot="logo" viewBox="0 0 340 56" aria-hidden="true"><text x="0" y="44" font-family="Bricolage Grotesque,sans-serif" font-weight="800" font-size="40" fill="currentColor" letter-spacing="-1.5">MOE<tspan fill="var(--c)">pilote</tspan></text></svg>
</Product>
<section class="contact" id="demo"><div class="wrap">
  <div><div class="eyebrow">Démo</div><h2 style="margin-top:14px">Apportez votre dernier CR. On le refait en dictée devant vous.</h2><p class="lead">15 minutes, en visio ou sur place en Ille-et-Vilaine. Vous repartez avec votre compte rendu diffusé.</p></div>
  <DemoForm label="Demander une démo" defaultRole="Maître d'œuvre" />
</div></section>
<AppLd name="MOEpilote" url="/moepilote/" audience="Maîtres d'œuvre et architectes" price="79" status="Pilotes en cours en Bretagne" description="Application pour maîtres d'œuvre : compte rendu de chantier dicté et diffusé avec accusés de lecture, contrôle des assurances décennales des entreprises, mise au point (MAP), situations, portail client inclus." />
<Faq items={[
  ["Qu'est-ce que MOEpilote ?", "MOEpilote est l'application des maîtres d'œuvre éditée par Kaërt. Elle rédige le compte rendu de chantier à partir d'une dictée, le diffuse avec accusés de lecture et relances, contrôle les attestations d'assurance des entreprises lot par lot, fait signer la mise au point au client et vise les situations sur l'avancement réel. Chaque action attend le OUI du maître d'œuvre."],
  ["Combien de temps prend un compte rendu de chantier avec MOEpilote ?", "Environ cinq minutes : deux à trois minutes de dictée en sortant de la visite, puis une relecture. L'agent identifie les entreprises, classe réserves et actions, fixe les délais et produit deux versions : technique pour les entreprises, en clair pour le client."],
  ["Comment MOEpilote vérifie-t-il une attestation décennale ?", "Il lit l'attestation (photo ou PDF), extrait l'assureur, la période, les activités couvertes, et les croise avec le lot du marché. Si le lot comprend une pompe à chaleur et que l'attestation ne couvre pas le chauffage, il le signale. Il relance avant expiration et bloque le visa d'une situation tant que le dossier n'est pas à jour."],
  ["Qu'est-ce que la MAP dans MOEpilote ?", "La réunion de mise au point, avant l'ouverture du chantier : plans, devis, entreprises retenues, cahier des choix (carrelage, sanitaires, menuiseries…), planning et budget sont validés par le client dans l'application, point par point, et signés."],
  ["Combien coûte MOEpilote ?", "79 € HT par mois et par maître d'œuvre, portail client illimité inclus, options à la carte. Prix bloqué à vie pour les 200 premiers cabinets."],
  ["Mes clients et mes entreprises doivent-ils créer un compte ?", "Non. Ils reçoivent un lien. Le client voit photos, compte rendu en clair, décisions à prendre et factures vérifiées ; les entreprises reçoivent le CR, les plans à jour et les demandes de pièces, avec accusé de lecture."],
]} />
</Page>
