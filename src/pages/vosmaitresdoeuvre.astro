---
import Page from '../layouts/Page.astro';
import data from '../data/pages/vosmaitresdoeuvre.json';
import Product from '../components/Product.astro';
import Faq from '../components/Faq.astro';
import DemoForm from '../components/DemoForm.astro';
---
<Page title={data.title} description={data.description} path={data.path}>
<Product {...data.product}>
  <svg slot="logo" viewBox="0 0 420 56" aria-hidden="true"><text x="0" y="44" font-family="Bricolage Grotesque,sans-serif" font-weight="800" font-size="34" fill="currentColor" letter-spacing="-1.5">VosMaîtresd<tspan fill="var(--c)">Œuvre</tspan></text></svg>
</Product>
<section class="contact" id="ref"><div class="wrap">
  <div><div class="eyebrow">Maîtres d'œuvre</div><h2 style="margin-top:14px">Référencer mon cabinet</h2><p class="lead">On vérifie votre SIREN et vos assurances, on crée votre fiche avec vos réalisations. La fiche est gratuite ; les projets de votre zone arrivent avec l'abonnement.</p></div>
  <DemoForm label="Référencer mon cabinet" defaultRole="Maître d'œuvre" />
</div></section>
<Faq title={data.faq.title} items={data.faq.items.map((i: any) => [i.q, i.a] as [string, string])} />
</Page>
