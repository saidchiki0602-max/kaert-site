---
import Page from '../layouts/Page.astro';
import data from '../data/pages/404.json';
import { L } from '../lib/links';
---
<Page title={data.title} description={data.description} path={data.path}>
<main class="page"><div class="wrap">
  <h1>Pas de chantier ici.</h1>
  <p>La page que vous cherchez n'existe pas ou a déménagé.</p>
  <p><a class="btn p" href={L('/')}>Retour à l'accueil</a></p>
</div></main>
</Page>
