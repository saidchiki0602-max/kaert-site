---
import Page from '../layouts/Page.astro';
import data from '../data/pages/artisandispo.json';
import Product from '../components/Product.astro';
import Faq from '../components/Faq.astro';
import AppLd from '../components/AppLd.astro';
import DemoForm from '../components/DemoForm.astro';
---
<Page title={data.title} description={data.description} path={data.path}>
<AppLd {...(data as any).app} />
<Product {...data.product}>
  <svg slot="logo" viewBox="0 0 340 56" aria-hidden="true"><text x="0" y="44" font-family="Bricolage Grotesque,sans-serif" font-weight="800" font-size="34" fill="currentColor" letter-spacing="-1.5">Artisan<tspan fill="var(--c)">Dispo</tspan></text></svg>
</Product>
<section class="contact" id="alerte"><div class="wrap">
  <div><div class="eyebrow">Ouverture</div><h2 style="margin-top:14px">Être prévenu à l'ouverture.</h2><p class="lead">Particulier : un e-mail quand ArtisanDispo ouvre dans votre département. Artisan : on vous contacte pour vérifier vos assurances et vous inscrire parmi les premiers.</p></div>
  <DemoForm label="Me prévenir" />
</div></section>
<Faq title={data.faq.title} items={data.faq.items.map((i: any) => [i.q, i.a] as [string, string])} />
</Page>
