---
import Page from '../layouts/Page.astro';
import data from '../data/pages/valotravaux.json';
import Faq from '../components/Faq.astro';
import AppLd from '../components/AppLd.astro';
import Product from '../components/Product.astro';
import DemoForm from '../components/DemoForm.astro';
---
<Page title={data.title} description={data.description} path={data.path}>
<Product {...data.product}>
  <svg slot="logo" viewBox="0 0 340 56" aria-hidden="true"><rect x="4" y="12" width="32" height="32" rx="6" fill="var(--c)"/><text x="11" y="36" font-family="Bricolage Grotesque,sans-serif" font-weight="800" font-size="24" fill="#fff">V</text><text x="48" y="44" font-family="Bricolage Grotesque,sans-serif" font-weight="800" font-size="36" fill="currentColor" letter-spacing="-1.5">Valo<tspan fill="var(--c)">Travaux</tspan></text></svg>
</Product>
<section class="contact" id="demo"><div class="wrap">
  <div><div class="eyebrow">Pour les agences</div><h2 style="margin-top:14px">Apportez une annonce de bien à rénover.</h2><p class="lead">On chiffre les travaux et la sortie de passoire devant vous, en 15 minutes. Vous repartez avec la fiche.</p></div>
  <DemoForm label="Demander une démo" defaultRole="Agent immobilier" />
</div></section>
<AppLd {...(data as any).app} />
<Faq title={data.faq.title} items={data.faq.items.map((i: any) => [i.q, i.a] as [string, string])} />
</Page>
