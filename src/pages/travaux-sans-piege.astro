---
import Page from '../layouts/Page.astro';
import data from '../data/pages/travaux-sans-piege.json';
import Faq from '../components/Faq.astro';
import AppLd from '../components/AppLd.astro';
import Product from '../components/Product.astro';
import { L } from '../lib/links';
---
<Page title={data.title} description={data.description} path={data.path}>
<Product {...data.product}>
  <svg slot="logo" viewBox="0 0 420 56" fill="none" aria-hidden="true"><path d="M6 30 22 16l16 14" stroke="var(--c)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/><path d="M11 28v16h22V28" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/><path d="m17 36 3 3 6-7" stroke="var(--c)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/><text x="50" y="44" font-family="Bricolage Grotesque,sans-serif" font-weight="800" font-size="34" fill="currentColor" letter-spacing="-1.5">Travaux <tspan fill="var(--c)">Sans Piège</tspan></text></svg>
</Product>
<section class="sec" id="ouvert" style="border-top:2px solid var(--fg)"><div class="wrap">
  <h2>Le site Travaux Sans Piège est ouvert.</h2>
  <p class="lead">La vérification de devis est gratuite, et les guides répondent aux questions du particulier qui suit ses travaux lui-même : avant de signer, pendant le chantier, à la réception.</p>
  <p style="margin-top:20px"><a class="btn p" href="https://travauxsanspiege.fr/verifier-un-devis/">Vérifier un devis de travaux →</a></p>
  <div class="grid2" style="margin-top:28px">
    <a class="box" href="https://travauxsanspiege.fr/guides/acompte-artisan/" style="text-decoration:none;color:inherit"><div class="meta">Avant de signer</div><h3>Acompte artisan : combien payer à la signature →</h3><p>30 % à la commande, et quoi répondre à qui demande 50 %.</p></a>
    <a class="box" href="https://travauxsanspiege.fr/guides/suivre-son-chantier-seul/" style="text-decoration:none;color:inherit"><div class="meta">Pendant le chantier</div><h3>Suivre son chantier seul →</h3><p>Planning, visite hebdomadaire, ce qu'on vérifie avant que ce soit recouvert.</p></a>
    <a class="box" href="https://travauxsanspiege.fr/modele-pv-reception-travaux/" style="text-decoration:none;color:inherit"><div class="meta">À la réception</div><h3>Modèle de PV de réception de travaux →</h3><p>Le procès-verbal en deux pages, à télécharger en PDF.</p></a>
    <a class="box" href="https://travauxsanspiege.fr/guides/construire-maison-lots-separes/" style="text-decoration:none;color:inherit"><div class="meta">Maison neuve</div><h3>Construire sa maison sans constructeur →</h3><p>Les douze étapes en lots séparés, et ce qu'on vérifie à chaque relais.</p></a>
  </div>
  <p style="margin-top:20px"><a href="https://travauxsanspiege.fr/guides/">Tous les guides de Travaux Sans Piège →</a></p>
</div></section>
<section class="sec" style="border-top:2px solid var(--fg)"><div class="wrap">
  <h2>Vous préférez être accompagné ?</h2>
  <p class="lead">Pour un projet lourd — maison neuve, extension, rénovation complète — un maître d'œuvre vous fait gagner plus qu'il ne coûte. On vous aide à en comparer jusqu'à trois.</p>
  <div class="grid2"><a class="box" href={L('/vosmaitresdoeuvre/')} style="text-decoration:none;color:inherit"><div class="meta">Maîtres d'œuvre</div><h3>VosMaîtresdŒuvre →</h3><p>Comparer jusqu'à trois maîtres d'œuvre vérifiés, les rencontrer, choisir.</p></a><a class="box" href={L('/courtiertravaux/')} style="text-decoration:none;color:inherit"><div class="meta">Courtier en travaux</div><h3>CourtierTravaux.com →</h3><p>Un courtier cadre votre projet, consulte trois entreprises, compare, négocie et suit.</p></a></div>
</div></section>
<AppLd {...(data as any).app} />
<Faq title={data.faq.title} items={data.faq.items.map((i: any) => [i.q, i.a] as [string, string])} />
</Page>
