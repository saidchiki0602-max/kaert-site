---
import Page from '../layouts/Page.astro';
import data from '../data/pages/demo.json';
import Faq from '../components/Faq.astro';
import DemoForm from '../components/DemoForm.astro';
---
<Page title={data.title} description={data.description} path={data.path}>
<section class="contact" style="padding-top:clamp(48px,8vw,104px)"><div class="wrap">
  <div>
    <div class="eyebrow">Démo et contact</div>
    <h2 style="margin-top:14px">15 minutes, sur votre cas réel.</h2>
    <p class="lead">Un agent apporte une annonce de bien à rénover. Un maître d'œuvre apporte son dernier compte rendu, on le refait en dictée devant lui. Un artisan apporte un devis fait hier soir. Pas de démo générique : on travaille sur ce que vous avez fait cette semaine.</p>
    <ul style="margin:26px 0 0;padding:0;list-style:none;display:grid;gap:10px;color:var(--fg2)">
      <li>— Vous recevez un SMS de confirmation avec un créneau proposé.</li>
      <li>— La démo se fait en visio ou sur place en Ille-et-Vilaine, 15 minutes, sur votre document.</li>
      <li>— Si l'outil n'est pas prêt pour votre métier, on vous le dit, et on vous prévient à l'ouverture.</li>
    </ul>
    <div class="addr">Kaërt Groupe<small>Bretagne</small><small><span id="mail" style="user-select:all">contact@kaertgroupe.com</span> <button class="btn s" type="button" style="padding:6px 10px;font-size:.8rem;margin-left:8px" id="copy-mail">Copier</button></small></div>
  </div>
  <DemoForm />
</div></section>
<script>
  document.getElementById('copy-mail')?.addEventListener('click', () => {
    const el = document.getElementById('mail')!; const m = el.textContent || '';
    const sel = () => { const r = document.createRange(); r.selectNodeContents(el); const s = getSelection(); s?.removeAllRanges(); s?.addRange(r); };
    try { navigator.clipboard.writeText(m).catch(sel); } catch { sel(); }
  });
</script>
<Faq title={data.faq.title} items={data.faq.items.map((i: any) => [i.q, i.a] as [string, string])} />
</Page>
