---
import Page from '../layouts/Page.astro';
import Product from '../components/Product.astro';
import DemoForm from '../components/DemoForm.astro';
---
<Page title="Conformité Travaux — Les pièces travaux avant l'acte" description="Pour les notaires et vendeurs : permis, achèvement, dommages-ouvrage, décennales. Ce qui manque et comment le régulariser. Ouverture 2027." path="/conformite-travaux/">
<Product who="Notaires · vendeurs" status="2027" color="var(--not)"
  title="Les pièces travaux qui bloquent un acte, trouvées avant la signature."
  sub="Pour les notaires et les vendeurs : permis, déclaration d'achèvement, dommages-ouvrage, décennales, RE2020. Ce qui manque, et comment le régulariser."
  feats={[
    { t: 'La liste des pièces attendues', p: "selon la nature et la date des travaux déclarés : permis ou déclaration préalable, DAACT, attestation RE2020, dommages-ouvrage, décennales des entreprises, PV de réception." },
    { t: 'Ce qui manque et ce que ça risque', p: "report, réserve, baisse de prix, responsabilité : pour chaque pièce absente, la conséquence sur l'acte, dite clairement au vendeur avant le compromis." },
    { t: 'La régularisation', p: "qui contacter, quel délai, quel coût : mairie, assureur, entreprise, bureau de contrôle. Le chemin pour signer à la date prévue." },
  ]}
  price={{ big: '2027', p: "Le premier pas est gratuit : l'outil « Dossier travaux complet pour l'acte ? » — cinq questions, et la liste des pièces qui manqueront.", items: ['Outil gratuit en premier, sans compte', 'Puis le dossier du bien complet, issu des chantiers Kōv et MOEpilote', 'Laissez votre e-mail : on vous prévient à l’ouverture'] }}
  cta={{ label: 'Être prévenu à l’ouverture', href: '/conformite-travaux/#alerte' }}>
  <svg slot="logo" viewBox="0 0 340 56" aria-hidden="true"><text x="0" y="44" font-family="Bricolage Grotesque,sans-serif" font-weight="800" font-size="30" fill="currentColor" letter-spacing="-1.2">Conformité<tspan fill="var(--c)"> Travaux</tspan></text></svg>
</Product>
<section class="contact" id="alerte"><div class="wrap">
  <div><div class="eyebrow">Ouverture 2027</div><h2 style="margin-top:14px">Être prévenu à l'ouverture.</h2><p class="lead">Un e-mail à l'ouverture de l'outil gratuit, un autre au lancement. Rien entre les deux.</p></div>
  <DemoForm label="Me prévenir" defaultRole="Notaire" />
</div></section>
</Page>
